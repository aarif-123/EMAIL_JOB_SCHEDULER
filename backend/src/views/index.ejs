        --body-bg: #F9FAFB !important;
        --header-bg: #FFFFFF !important;
        --card-bg: #FFFFFF !important;
        --card-text-secondary-color: #6B7280 !important;
        --text-color: #111827 !important;
        --text-secondary-color: #6B7280 !important;
        --accent-color: #00A859 !important;
        --accent-color-d1: #008746 !important;
        --separator-color: #E5E7EB !important;
        --button-primary-bg: #00A859 !important;
